			interrupt-parent = <0x4>;
			interrupts = <0x0 0x1f 0x4 0x0 0x20 0x4>;
			reg = <0x40400000 0x10000>;
			xlnx,addrwidth = [20];
			xlnx,include-dre;
			xlnx,num-queues = [00 01];
			phandle = <0x14>;
		};
		serial@43c10000 {
			clock-frequency = <0x5f5e100>;
			clock-names = "s_axi_aclk";
