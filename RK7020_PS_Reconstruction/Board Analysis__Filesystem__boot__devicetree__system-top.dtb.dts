			phandle = <0x46>;
			eeprom1@50 {
				compatible = "atmel,24c256";
				reg = <0x50>;
				pagesize = <0x20>;
			};
		};
		gpio@41220000 {
			#gpio-cells = <0x2>;
			clock-names = "s_axi_aclk";
			clocks = <0x1 0xf>;
			compatible = "xlnx,axi-gpio-2.0", "xlnx,xps-gpio-1.00.a";
			gpio-controller;
			reg = <0x41220000 0x10000>;
			xlnx,all-inputs = <0x0>;
			xlnx,all-inputs-2 = <0x0>;
			xlnx,all-outputs = <0x0>;
			xlnx,all-outputs-2 = <0x0>;
			xlnx,dout-default = <0x0>;
			xlnx,dout-default-2 = <0x0>;
			xlnx,gpio-width = <0x20>;
			xlnx,gpio2-width = <0x2>;
			xlnx,interrupt-present = <0x0>;
			xlnx,is-dual = <0x1>;
			xlnx,tri-default = <0xffffffff>;
			xlnx,tri-default-2 = <0xffffffff>;
			phandle = <0x47>;
		};
		gpio@41230000 {
			#gpio-cells = <0x2>;
			clock-names = "s_axi_aclk";
			clocks = <0x1 0xf>;
			compatible = "xlnx,axi-gpio-2.0", "xlnx,xps-gpio-1.00.a";
			gpio-controller;
			reg = <0x41230000 0x10000>;
			xlnx,all-inputs = <0x0>;
			xlnx,all-inputs-2 = <0x0>;
			xlnx,all-outputs = <0x0>;
			xlnx,all-outputs-2 = <0x0>;
			xlnx,dout-default = <0x0>;
			xlnx,dout-default-2 = <0x0>;
			xlnx,gpio-width = <0x2>;
			xlnx,gpio2-width = <0x20>;
			xlnx,interrupt-present = <0x0>;
			xlnx,is-dual = <0x0>;
			xlnx,tri-default = <0xffffffff>;
			xlnx,tri-default-2 = <0xffffffff>;
			phandle = <0x48>;
		};
		axi_dynclk@43c00000 {
			clock-names = "REF_CLK_I", "s_axi_lite_aclk";
			clocks = <0x1 0xf>;
			compatible = "dglnt,axi-dynclk";
			reg = <0x43c00000 0x10000>;
			#clock-cells = <0x0>;
			phandle = <0x1a>;
		};
		ethernet@41000000 {
			axistream-connected = <0x14>;
			axistream-control-connected = <0x14>;
			clock-frequency = <0x5f5e100>;
			clock-names = "s_axi_lite_clk", "axis_clk", "gtx_clk", "ref_clk";
			clocks = <0x1 0xf 0x1 0xf 0x15 0x16>;
			compatible = "xlnx,axi-ethernet-7.2", "xlnx,axi-ethernet-1.00.a";
			device_type = "network";
			interrupt-names = "mac_irq", "interrupt", "mm2s_introut", "s2mm_introut";
			interrupt-parent = <0x4>;
			interrupts = <0x0 0x1d 0x1 0x0 0x1e 0x4 0x0 0x1f 0x4 0x0 0x20 0x4>;
			local-mac-address = [00 0a 35 00 01 22];
			phy-mode = "rgmii-rxid";
			reg = <0x41000000 0x40000>;
			xlnx = <0x0>;
			xlnx,axiliteclkrate = <0x0>;
			xlnx,axisclkrate = <0x0>;
			xlnx,channel-ids = "1";
			xlnx,clockselection = <0x0>;
			xlnx,enableasyncsgmii = <0x0>;
			xlnx,gt-type = <0x0>;
			xlnx,gtinex = <0x0>;
			xlnx,gtlocation = <0x0>;
			xlnx,gtrefclksrc = <0x0>;
			xlnx,include-dre;
			xlnx,instantiatebitslice0 = <0x0>;
			xlnx,num-queues = [00 01];
			xlnx,phyaddr = <0x1>;
			xlnx,phyrst-board-interface-dummy-port = <0x0>;
			xlnx,rable = <0x0>;
			xlnx,rxcsum = <0x2>;
			xlnx,rxlane0-placement = <0x0>;
			xlnx,rxlane1-placement = <0x0>;
			xlnx,rxmem = <0x4000>;
			xlnx,rxnibblebitslice0used = <0x0>;
			xlnx,tx-in-upper-nibble = <0x1>;
			xlnx,txcsum = <0x2>;
			xlnx,txlane0-placement = <0x0>;
			xlnx,txlane1-placement = <0x0>;
			xlnx,versal-gt-board-flow = <0x0>;
			zclock-names = "NULL";
			zclocks = "NULL";
			phy-handle = <0x17>;
			xlnx,has-mdio = <0x1>;
			phandle = <0x18>;
			mdio {
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				phandle = <0x49>;
				phy@1 {
					device_type = "ethernet-phy";
					reg = <0x1>;
					phandle = <0x17>;
				};
			};
		};
		misc_clk_0 {
			#clock-cells = <0x0>;
			clock-frequency = <0x7735940>;
			compatible = "fixed-clock";
			phandle = <0x15>;
		};
		misc_clk_1 {
			#clock-cells = <0x0>;
			clock-frequency = <0xbebc200>;
			compatible = "fixed-clock";
			phandle = <0x16>;
		};
		dma@40400000 {
			#dma-cells = <0x1>;
			axistream-connected = <0x18>;
			axistream-control-connected = <0x18>;
			clock-names = "s_axi_lite_aclk", "m_axi_sg_aclk", "m_axi_mm2s_aclk", "m_axi_s2mm_aclk";
			clocks = <0x1 0xf 0x1 0xf 0x1 0xf 0x1 0xf>;
