			clock-names = "apb_pclk", "dbg_trc", "dbg_apb";
			cpu = <0x12>;
			out-ports {
				port {
					endpoint {
						remote-endpoint = <0x13>;
						phandle = <0xf>;
					};
				};
			};
		};
	};
	amba_pl {
		#address-cells = <0x1>;
