			interrupt-names = "irq";
			interrupt-parent = <0x4>;
			interrupts = <0x0 0x24 0x4>;
			reg = <0x43c30000 0x10000>;
			xlnx,generator;
			xlnx,pixels-per-clock = <0x1>;
			phandle = <0x1e>;
		};
		misc_clk_2 {
			#clock-cells = <0x0>;
			clock-frequency = <0x5f5e100>;
			compatible = "fixed-clock";
			phandle = <0x19>;
		};
		digilent_hdmi {
			compatible = "digilent,hdmi";
			clocks = <0x1a>;
			clock-names = "clk";
