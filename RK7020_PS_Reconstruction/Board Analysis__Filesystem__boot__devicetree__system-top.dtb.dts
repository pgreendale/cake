			digilent,fmax = <0x249f0>;
			port@0 {
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				endpoint {
					remote-endpoint = <0x1c>;
					phandle = <0x1f>;
				};
			};
		};
		xlnx_pl_disp {
			compatible = "xlnx,pl-disp";
			dmas = <0x1d 0x0>;
			dma-names = "dma0";
			xlnx,vformat = "RG24";
			xlnx,bridge = <0x1e>;
			port@0 {
				reg = <0x0>;
				endpoint {
					remote-endpoint = <0x1f>;
					phandle = <0x1c>;
				};
			};
		};
